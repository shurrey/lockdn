  "notes": [
    {
      "id": "note-psych-ch1",
      "courseId": "course-psych101",
      "title": "Chapter 1: History of Psychology",
      "images": [],
      "extractedText": "Psychology emerged as a scientific discipline in the late 19th century. Wilhelm Wundt established the first psychology laboratory in 1879. Key schools of thought include structuralism, functionalism, behaviorism, and cognitive psychology.",
      "aiSummary": "Overview of psychology's history from Wundt's first lab to modern cognitive approaches.",
      "topics": ["history", "structuralism", "functionalism", "behaviorism"],
      "createdAt": "2025-01-15T10:30:00.000Z",
      "updatedAt": "2025-01-15T10:30:00.000Z"
    },
    {
      "id": "note-psych-ch2",
      "courseId": "course-psych101",
      "title": "Chapter 2: Research Methods",
      "images": [],
      "extractedText": "Scientific method in psychology: observation, hypothesis, experiment, analysis. Key concepts: independent and dependent variables, control groups, random assignment, correlation vs causation.",
      "aiSummary": "Research methodology fundamentals including experimental design and statistical concepts.",
      "topics": ["research methods", "variables", "experiments", "correlation"],
      "createdAt": "2025-01-17T11:15:00.000Z",
      "updatedAt": "2025-01-17T11:15:00.000Z"
    },
    {
      "id": "note-calc-integration",
      "courseId": "course-calc2",
      "title": "Integration by Parts",
      "images": [],
      "extractedText": "Integration by parts formula: ∫u dv = uv - ∫v du. LIATE rule for choosing u: Logarithmic, Inverse trig, Algebraic, Trigonometric, Exponential. Practice: ∫x·e^x dx, ∫x·sin(x) dx",
      "aiSummary": "Integration by parts technique with LIATE selection rule and examples.",
      "topics": ["integration", "calculus", "techniques"],
      "createdAt": "2025-01-20T14:00:00.000Z",
      "updatedAt": "2025-01-20T14:00:00.000Z"
    },
    {
      "id": "note-cs-complexity",
      "courseId": "course-compsci",
      "title": "Big O Notation",
      "images": [],
      "extractedText": "Big O describes worst-case time complexity. Common complexities: O(1) constant, O(log n) logarithmic, O(n) linear, O(n log n) linearithmic, O(n²) quadratic, O(2^n) exponential. Space complexity also matters.",
      "aiSummary": "Time and space complexity analysis using Big O notation.",
      "topics": ["algorithms", "complexity", "big o", "efficiency"],
      "createdAt": "2025-01-22T14:30:00.000Z",
      "updatedAt": "2025-01-22T14:30:00.000Z"
    }
  ],
