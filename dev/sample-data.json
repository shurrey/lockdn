      "createdAt": "2025-02-01T16:00:00.000Z",
      "updatedAt": "2025-02-01T16:00:00.000Z"
    },
    {
      "id": "material-psych-exam",
      "courseId": "course-psych101",
      "type": "practice_exam",
      "title": "Psychology Practice Exam",
      "content": "Practice questions for PSY 101 midterm",
      "sourceNoteIds": ["note-psych-ch1", "note-psych-ch2"],
      "questions": [
        {
          "id": "q1",
          "type": "multiple_choice",
          "bloomLevel": "knowledge",
          "question": "Who established the first psychology laboratory?",
          "options": ["Sigmund Freud", "Wilhelm Wundt", "William James", "B.F. Skinner"],
          "correctAnswer": "Wilhelm Wundt",
          "explanation": "Wilhelm Wundt established the first psychology laboratory in Leipzig, Germany in 1879."
        },
        {
          "id": "q2",
          "type": "multiple_choice",
          "bloomLevel": "comprehension",
          "question": "What is the key difference between correlation and causation?",
          "options": [
            "Correlation is stronger than causation",
            "Causation implies one variable directly affects another, while correlation only shows a relationship",
            "They mean the same thing",
            "Correlation can only be positive"
          ],
          "correctAnswer": "Causation implies one variable directly affects another, while correlation only shows a relationship",
          "explanation": "Correlation shows two variables are related, but doesn't prove one causes the other."
        },
        {
          "id": "q3",
          "type": "fill_in_blank",
          "bloomLevel": "knowledge",
          "question": "The variable that is manipulated by the researcher is called the _____ variable.",
          "correctAnswer": "independent",
          "explanation": "The independent variable is controlled/manipulated by the researcher to observe its effects."
        }
      ],
      "createdAt": "2025-02-02T10:00:00.000Z",
      "updatedAt": "2025-02-02T10:00:00.000Z"
    }
